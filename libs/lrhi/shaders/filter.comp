            else if(a.x==1)nits=mix((exp((c.rgb-.55991073)/.17883277)+.28466892)/12,c.rgb*c.rgb/3,lessThanEqual(c.rgb,vec3(.5)))*a.y;
            else nits=c.rgb*a.y;
            vec3 v=nits/a.z;float white=a.y/a.z;linear=v*(1+v/(white*white))/(1+v);
        }
        c.rgb=srgb(linear);
    }
    c=clamp(c,0,1); c.rgb=linear_rgb(c.rgb)*c.a; imageStore(target,pos,c);
}
