#version 450
// Camera YUV to straight RGBA8, the same bytes swscale would have produced on the CPU.
// Upload is half (I420/NV12) or two thirds (YUYV) of the BGRA it replaces.
layout(local_size_x=16, local_size_y=16) in;
layout(binding=0, rgba8) uniform writeonly image2D target;
layout(std430, binding=3) readonly buffer Planes { uint bytes[]; } yuv;
// rect.x layout (1 YUYV, 2 I420, 3 NV12); rect.y matrix bits (1 = BT.709, 2 = full range).
layout(push_constant) uniform Push { ivec4 rect; } p;
uint byte_at(uint i) { return (yuv.bytes[i >> 2] >> ((i & 3u) * 8u)) & 255u; }
void main() {
    ivec2 pos=ivec2(gl_GlobalInvocationID.xy), size=imageSize(target);
    if (any(greaterThanEqual(pos,size))) return;
    uint w=uint(size.x), h=uint(size.y), x=uint(pos.x), y=uint(pos.y);
    float Y, U, V;
    if (p.rect.x == 1) {
        uint at=(y*w+(x&~1u))*2u;
        Y=float(byte_at(at+(x&1u)*2u)); U=float(byte_at(at+1u)); V=float(byte_at(at+3u));
    } else {
        uint luma=w*h, c=(y>>1)*(w>>1)+(x>>1);
        Y=float(byte_at(y*w+x));
        if (p.rect.x == 2) { U=float(byte_at(luma+c)); V=float(byte_at(luma+luma/4u+c)); }
        else { uint at=luma+(y>>1)*w+(x&~1u); U=float(byte_at(at)); V=float(byte_at(at+1u)); }
    }
    bool bt709=(p.rect.y & 1) != 0, full=(p.rect.y & 2) != 0;
    float yn=full ? Y/255.0 : (Y-16.0)/219.0;
    float u=(U-128.0)/(full ? 255.0 : 224.0), v=(V-128.0)/(full ? 255.0 : 224.0);
    vec3 rgb=bt709 ? vec3(yn+1.5748*v, yn-0.1873*u-0.4681*v, yn+1.8556*u)
                   : vec3(yn+1.402*v, yn-0.344136*u-0.714136*v, yn+1.772*u);
    imageStore(target,pos,vec4(clamp(rgb,0.0,1.0),1.0));
}
